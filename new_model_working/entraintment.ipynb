   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1f14f663",
   "metadata": {},
   "outputs": [],
   "source": [
    "def entraintment(entraintment_rate,theta_t,q_t,Z):\n",
    "\n",
    "    dZ = np.diff(Z)\n",
    "    q_t[1:] = q_t[0:-1] - entraintment_rate * (q_t[0:-1])*dZ\n",
    "\n",
    "    theta_t[1:] = theta_t[0:-1] - entraintment_rate * (theta_t[0:-1])*dZ\n",
    "\n",
    "    return q_t,theta_t"
   ]
  }
 ],
