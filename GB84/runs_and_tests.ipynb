    "def classify_wet_dry(data, threshold):\n",
    "    \"\"\"Convert rainfall rates into wet (1) / dry (0) sequence\"\"\"\n",
    "    return (data > threshold).astype(int)\n",
    "\n",
    "def calculate_transition_matrix(wet_dry_sequence):\n",
    "    \"\"\"Calculate 2x2 transition probability matrix for wet/dry states\"\"\"\n",
    "    transitions = {\n",
    "        'dry_to_dry': 0,\n",
    "        'dry_to_wet': 0,\n",
    "        'wet_to_dry': 0,\n",
    "        'wet_to_wet': 0\n",
    "    }\n",
    "    dry_count = 0\n",
    "    wet_count = 0\n",
    "    \n",
    "    for i in range(len(wet_dry_sequence) - 1):\n",
    "        current_state = wet_dry_sequence[i]\n",
    "        next_state = wet_dry_sequence[i + 1]\n",
    "        \n",
    "        if current_state == 0:  # dry\n",
    "            dry_count += 1\n",
    "            if next_state == 0:\n",
    "                transitions['dry_to_dry'] += 1\n",
    "            else:\n",
    "                transitions['dry_to_wet'] += 1\n",
    "        else:  # wet\n",
    "            wet_count += 1\n",
    "            if next_state == 0:\n",
    "                transitions['wet_to_dry'] += 1\n",
    "            else:\n",
    "                transitions['wet_to_wet'] += 1\n",
    "    \n",
    "    # Normalize to probabilities\n",
    "    return {\n",
    "        'P(dry|dry)': transitions['dry_to_dry'] / dry_count if dry_count > 0 else 0,\n",
    "        'P(wet|dry)': transitions['dry_to_wet'] / dry_count if dry_count > 0 else 0,\n",
    "        'P(dry|wet)': transitions['wet_to_dry'] / wet_count if wet_count > 0 else 0,\n",
    "        'P(wet|wet)': transitions['wet_to_wet'] / wet_count if wet_count > 0 else 0\n",
    "    }\n",
    "\n",
    "def plot_transition_comparison(model_probs, obs_probs, title=\"Transition Probabilities Comparison\"):\n",
