    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from collections import defaultdict\n",
    "\n",
    "def classify_wet_dry(data, threshold=0.1):\n",
    "    \"\"\"\n",
    "    Classify time intervals as wet (1) or dry (0) based on rainfall rate\n",
    "    \n",
    "    Parameters:\n",
    "    data: array-like, rainfall rates\n",
    "    threshold: float, minimum rainfall rate to consider as 'wet' (mm/h)\n",
    "    \n",
    "    Returns:\n",
    "    Binary array: 1 for wet, 0 for dry\n",
    "    \"\"\"\n",
    "    return (data > threshold).astype(int)\n",
    "\n",
    "def calculate_transition_matrix(wet_dry_sequence):\n",
    "    \"\"\"\n",
    "    Calculate 2x2 transition probability matrix\n",
    "    \n",
    "    Parameters:\n",
    "    wet_dry_sequence: binary array (0=dry, 1=wet)\n",
    "    \n",
    "    Returns:\n",
    "    dict: transition probabilities\n",
    "    \"\"\"\n",
    "    # Count transitions\n",
    "    transitions = {\n",
    "        'dry_to_dry': 0,\n",
    "        'dry_to_wet': 0,\n",
    "        'wet_to_dry': 0,\n",
    "        'wet_to_wet': 0\n",
    "    }\n",
    "    \n",
    "    # Count occurrences of each state\n",
    "    dry_count = 0\n",
    "    wet_count = 0\n",
    "    \n",
    "    for i in range(len(wet_dry_sequence) - 1):\n",
    "        current_state = wet_dry_sequence[i]\n",
    "        next_state = wet_dry_sequence[i + 1]\n",
    "        \n",
    "        if current_state == 0:  # Currently dry\n",
    "            dry_count += 1\n",
    "            if next_state == 0:\n",
    "                transitions['dry_to_dry'] += 1\n",
    "            else:\n",
    "                transitions['dry_to_wet'] += 1\n",
    "                \n",
    "        else:  # Currently wet\n",
    "            wet_count += 1\n",
    "            if next_state == 0:\n",
    "                transitions['wet_to_dry'] += 1\n",
    "            else:\n",
    "                transitions['wet_to_wet'] += 1\n",
    "    \n",
    "    # Calculate probabilities\n",
    "    prob_matrix = {}\n",
    "    if dry_count > 0:\n",
    "        prob_matrix['P(dry|dry)'] = transitions['dry_to_dry'] / dry_count\n",
    "        prob_matrix['P(wet|dry)'] = transitions['dry_to_wet'] / dry_count\n",
    "    else:\n",
    "        prob_matrix['P(dry|dry)'] = 0\n",
    "        prob_matrix['P(wet|dry)'] = 0\n",
    "        \n",
    "    if wet_count > 0:\n",
    "        prob_matrix['P(dry|wet)'] = transitions['wet_to_dry'] / wet_count\n",
    "        prob_matrix['P(wet|wet)'] = transitions['wet_to_wet'] / wet_count\n",
    "    else:\n",
    "        prob_matrix['P(dry|wet)'] = 0\n",
    "        prob_matrix['P(wet|wet)'] = 0\n",
    "    \n",
    "    # Store counts for reference\n",
    "    prob_matrix['counts'] = transitions\n",
    "    prob_matrix['state_counts'] = {'dry': dry_count, 'wet': wet_count}\n",
    "    \n",
    "    return prob_matrix\n",
    "\n",
    "def analyze_persistence_and_intermittency(wet_dry_sequence):\n",
    "    \"\"\"\n",
    "    Analyze persistence (consecutive wet/dry periods)\n",
    "    \n",
    "    Parameters:\n",
    "    wet_dry_sequence: binary array\n",
    "    \n",
    "    Returns:\n",
    "    dict: statistics about wet/dry spell lengths\n",
    "    \"\"\"\n",
    "    # Find run lengths\n",
    "    dry_spells = []\n",
    "    wet_spells = []\n",
    "    \n",
    "    current_spell = 1\n",
    "    current_state = wet_dry_sequence[0]\n",
    "    \n",
    "    for i in range(1, len(wet_dry_sequence)):\n",
    "        if wet_dry_sequence[i] == current_state:\n",
    "            current_spell += 1\n",
    "        else:\n",
    "            # End of spell\n",
    "            if current_state == 0:\n",
    "                dry_spells.append(current_spell)\n",
    "            else:\n",
    "                wet_spells.append(current_spell)\n",
    "            \n",
    "            # Start new spell\n",
    "            current_state = wet_dry_sequence[i]\n",
    "            current_spell = 1\n",
    "    \n",
    "    # Add the last spell\n",
    "    if current_state == 0:\n",
    "        dry_spells.append(current_spell)\n",
    "    else:\n",
    "        wet_spells.append(current_spell)\n",
    "    \n",
    "    return {\n",
    "        'dry_spells': dry_spells,\n",
    "        'wet_spells': wet_spells,\n",
    "        'avg_dry_spell': np.mean(dry_spells) if dry_spells else 0,\n",
    "        'avg_wet_spell': np.mean(wet_spells) if wet_spells else 0,\n",
    "        'max_dry_spell': max(dry_spells) if dry_spells else 0,\n",
    "        'max_wet_spell': max(wet_spells) if wet_spells else 0\n",
    "    }\n",
    "\n",
    "# Example usage with your data:\n",
    "\n",
    "# Assuming you have P (model precipitation) and rain_rate (observations)\n",
    "# You'll need to replace these with your actual data arrays\n",
    "# P_hourly = P * 3600  # Convert to mm/h if needed\n",
    "# rain_rate_values = rain_rate.values  # Extract values from xarray\n",
    "\n",
    "def compare_transition_probabilities(model_data, obs_data, threshold=0.1, time_index=None):\n",
    "    \"\"\"\n",
    "    Compare transition probabilities between model and observations\n",
    "    \n",
    "    Parameters:\n",
    "    model_data: array-like, model precipitation rates\n",
    "    obs_data: array-like, observed precipitation rates  \n",
    "    threshold: float, wet/dry threshold\n",
    "    time_index: array-like, time stamps for plotting\n",
    "    \n",
    "    Returns:\n",
    "    dict: comparison results\n",
    "    \"\"\"\n",
    "    \n",
    "    # Classify as wet/dry\n",
    "    model_wet_dry = classify_wet_dry(model_data, threshold)\n",
    "    obs_wet_dry = classify_wet_dry(obs_data, threshold)\n",
    "    \n",
    "    # Calculate transition matrices\n",
    "    model_transitions = calculate_transition_matrix(model_wet_dry)\n",
    "    obs_transitions = calculate_transition_matrix(obs_wet_dry)\n",
    "    \n",
    "    # Calculate marginal probabilities (fraction of wet intervals)\n",
    "    model_wet_fraction = np.mean(model_wet_dry)\n",
    "    obs_wet_fraction = np.mean(obs_wet_dry)\n",
    "    \n",
    "    # Analyze persistence\n",
    "    model_persistence = analyze_persistence_and_intermittency(model_wet_dry)\n",
    "    obs_persistence = analyze_persistence_and_intermittency(obs_wet_dry)\n",
    "    \n",
    "    # Create summary\n",
    "    results = {\n",
    "        'threshold': threshold,\n",
    "        'marginal_probabilities': {\n",
    "            'model_wet_fraction': model_wet_fraction,\n",
    "            'obs_wet_fraction': obs_wet_fraction\n",
    "        },\n",
    "        'transition_probabilities': {\n",
    "            'model': model_transitions,\n",
    "            'observations': obs_transitions\n",
    "        },\n",
    "        'persistence_analysis': {\n",
    "            'model': model_persistence,\n",
    "            'observations': obs_persistence\n",
    "        }\n",
    "    }\n",
    "    \n",
    "    return results\n",
    "\n",
    "def plot_transition_comparison(results, model_data=None, obs_data=None):\n",
    "    \"\"\"\n",
    "    Plot comparison of transition probabilities\n",
    "    \"\"\"\n",
    "    fig, ((ax1, ax2), (ax3, ax4)) = plt.subplots(2, 2, figsize=(12, 10))\n",
    "    \n",
    "    model_trans = results['transition_probabilities']['model']\n",
    "    obs_trans = results['transition_probabilities']['observations']\n",
    "    \n",
    "    # Transition probability comparison\n",
    "    transitions = ['P(dry|dry)', 'P(wet|dry)', 'P(dry|wet)', 'P(wet|wet)']\n",
    "    model_probs = [model_trans[t] for t in transitions]\n",
    "    obs_probs = [obs_trans[t] for t in transitions]\n",
    "    \n",
    "    x = np.arange(len(transitions))\n",
    "    width = 0.35\n",
    "    \n",
    "    ax1.bar(x - width/2, model_probs, width, label='Model', alpha=0.7)\n",
    "    ax1.bar(x + width/2, obs_probs, width, label='Observations', alpha=0.7)\n",
    "    ax1.set_xlabel('Transition Type')\n",
    "    ax1.set_ylabel('Probability')\n",
    "    ax1.set_title('Transition Probabilities Comparison')\n",
    "    ax1.set_xticks(x)\n",
    "    ax1.set_xticklabels(transitions, rotation=45)\n",
    "    ax1.legend()\n",
    "    ax1.grid(True, alpha=0.3)\n",
    "    \n",
    "    # Marginal probabilities\n",
    "    marginals = ['Dry Fraction', 'Wet Fraction']\n",
    "    model_marginals = [1 - results['marginal_probabilities']['model_wet_fraction'],\n",
    "                      results['marginal_probabilities']['model_wet_fraction']]\n",
    "    obs_marginals = [1 - results['marginal_probabilities']['obs_wet_fraction'],\n",
    "                    results['marginal_probabilities']['obs_wet_fraction']]\n",
    "    \n",
    "    x2 = np.arange(len(marginals))\n",
    "    ax2.bar(x2 - width/2, model_marginals, width, label='Model', alpha=0.7)\n",
    "    ax2.bar(x2 + width/2, obs_marginals, width, label='Observations', alpha=0.7)\n",
    "    ax2.set_xlabel('State')\n",
    "    ax2.set_ylabel('Fraction')\n",
    "    ax2.set_title('Marginal Probabilities')\n",
    "    ax2.set_xticks(x2)\n",
    "    ax2.set_xticklabels(marginals)\n",
    "    ax2.legend()\n",
    "    ax2.grid(True, alpha=0.3)\n",
    "    \n",
    "    # Average spell lengths\n",
    "    model_pers = results['persistence_analysis']['model']\n",
    "    obs_pers = results['persistence_analysis']['observations']\n",
    "    \n",
    "    spell_types = ['Avg Dry Spell', 'Avg Wet Spell']\n",
    "    model_spells = [model_pers['avg_dry_spell'], model_pers['avg_wet_spell']]\n",
    "    obs_spells = [obs_pers['avg_dry_spell'], obs_pers['avg_wet_spell']]\n",
    "    \n",
    "    x3 = np.arange(len(spell_types))\n",
    "    ax3.bar(x3 - width/2, model_spells, width, label='Model', alpha=0.7)\n",
    "    ax3.bar(x3 + width/2, obs_spells, width, label='Observations', alpha=0.7)\n",
    "    ax3.set_xlabel('Spell Type')\n",
    "    ax3.set_ylabel('Average Length (intervals)')\n",
    "    ax3.set_title('Average Spell Lengths')\n",
    "    ax3.set_xticks(x3)\n",
    "    ax3.set_xticklabels(spell_types)\n",
    "    ax3.legend()\n",
    "    ax3.grid(True, alpha=0.3)\n",
    "    \n",
    "    # Autocorrelation comparison (lag-1)\n",
    "    # Calculate lag-1 autocorrelation from transition probabilities\n",
    "    # For a binary sequence, lag-1 autocorr ≈ P(wet|wet) + P(dry|dry) - 1\n",
    "    model_autocorr = model_trans['P(wet|wet)'] + model_trans['P(dry|dry)'] - 1\n",
    "    obs_autocorr = obs_trans['P(wet|wet)'] + obs_trans['P(dry|dry)'] - 1\n",
    "    \n",
    "    # Alternative: if original data is provided, calculate directly\n",
    "    if model_data is not None and obs_data is not None:\n",
    "        threshold = results['threshold']\n",
    "        model_wet_dry = classify_wet_dry(model_data, threshold)\n",
    "        obs_wet_dry = classify_wet_dry(obs_data, threshold)\n",
    "        \n",
    "        if len(model_wet_dry) > 1:\n",
    "            model_autocorr = np.corrcoef(model_wet_dry[:-1], model_wet_dry[1:])[0,1]\n",
    "        if len(obs_wet_dry) > 1:\n",
    "            obs_autocorr = np.corrcoef(obs_wet_dry[:-1], obs_wet_dry[1:])[0,1]\n",
    "    \n",
    "    ax4.text(0.1, 0.7, f'Model Lag-1 Autocorr: {model_autocorr:.3f}', transform=ax4.transAxes)\n",
    "    ax4.text(0.1, 0.5, f'Obs Lag-1 Autocorr: {obs_autocorr:.3f}', transform=ax4.transAxes)\n",
    "    ax4.text(0.1, 0.3, 'Higher autocorrelation = more persistent', transform=ax4.transAxes)\n",
    "    ax4.set_title('Temporal Autocorrelation')\n",
    "    ax4.axis('off')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    return fig\n",
    "\n",
    "def print_transition_summary(results):\n",
    "    \"\"\"\n",
    "    Print a summary of transition probability analysis\n",
    "    \"\"\"\n",
    "    print(f\"Transition Probability Analysis (threshold = {results['threshold']} mm/h)\")\n",
    "    print(\"=\"*60)\n",
    "    \n",
    "    # Marginal probabilities\n",
    "    print(\"\\nMarginal Probabilities:\")\n",
    "    print(f\"Model - Wet fraction: {results['marginal_probabilities']['model_wet_fraction']:.3f}\")\n",
    "    print(f\"Observations - Wet fraction: {results['marginal_probabilities']['obs_wet_fraction']:.3f}\")\n",
    "    \n",
    "    # Transition probabilities\n",
    "    print(\"\\nTransition Probabilities:\")\n",
    "    model_trans = results['transition_probabilities']['model']\n",
    "    obs_trans = results['transition_probabilities']['observations']\n",
    "    \n",
    "    transitions = ['P(dry|dry)', 'P(wet|dry)', 'P(dry|wet)', 'P(wet|wet)']\n",
    "    for trans in transitions:\n",
    "        print(f\"{trans:10s}: Model = {model_trans[trans]:.3f}, Obs = {obs_trans[trans]:.3f}\")\n",
    "    \n",
    "    # Persistence analysis\n",
    "    print(\"\\nPersistence Analysis:\")\n",
    "    model_pers = results['persistence_analysis']['model']\n",
    "    obs_pers = results['persistence_analysis']['observations']\n",
    "    \n",
    "    print(f\"Average dry spell length: Model = {model_pers['avg_dry_spell']:.2f}, Obs = {obs_pers['avg_dry_spell']:.2f}\")\n",
    "    print(f\"Average wet spell length: Model = {model_pers['avg_wet_spell']:.2f}, Obs = {obs_pers['avg_wet_spell']:.2f}\")\n",
    "    print(f\"Maximum dry spell length: Model = {model_pers['max_dry_spell']}, Obs = {obs_pers['max_dry_spell']}\")\n",
    "    print(f\"Maximum wet spell length: Model = {model_pers['max_wet_spell']}, Obs = {obs_pers['max_wet_spell']}\")\n",
    "\n",
    "# Example usage with your actual data:\n",
    "# Replace P[0] with P (the full array) and ensure data alignment\n",
    "\n",
    "def prepare_data_for_analysis(model_array, obs_array, time_array=None):\n",
    "    \"\"\"\n",
    "    Prepare and align model and observation data for transition analysis\n",
    "    \"\"\"\n",
    "    # Convert to numpy arrays if needed\n",
    "    if hasattr(model_array, 'values'):\n",
    "        model_array = model_array.values\n",
    "    if hasattr(obs_array, 'values'):\n",
    "        obs_array = obs_array.values\n",
    "    \n",
    "    # Ensure we have 1D arrays\n",
    "    model_array = np.asarray(model_array).flatten()\n",
    "    obs_array = np.asarray(obs_array).flatten()\n",
    "    \n",
    "    # Find common length\n",
    "    min_length = min(len(model_array), len(obs_array))\n",
    "    model_array = model_array[:min_length]\n",
    "    obs_array = obs_array[:min_length]\n",
    "    \n",
    "    # Remove NaN values\n",
    "    valid_mask = ~(np.isnan(model_array) | np.isnan(obs_array))\n",
    "    model_array = model_array[valid_mask]\n",
    "    obs_array = obs_array[valid_mask]\n",
    "    \n",
    "    if time_array is not None:\n",
    "        time_array = time_array[:min_length][valid_mask]\n",
    "        return model_array, obs_array, time_array\n",
    "    \n",
    "    return model_array, obs_array\n",
    "\n",
    "# Example usage:\n",
    "if __name__ == \"__main__\":\n",
    "    # Use this with your actual data:\n",
    "    # model_precip, observed_precip = prepare_data_for_analysis(P * 3600, rain_rate.values)\n",
    "    # results = compare_transition_probabilities(model_precip, observed_precip, threshold=0.1)\n",
    "    \n",
    "    # Example with synthetic data for demonstration\n",
    "    np.random.seed(42)\n",
    "    time_length = 1000\n",
    "    \n",
    "    # Create synthetic data with different temporal structures\n",
    "    model_precip = np.random.exponential(0.5, time_length)\n",
    "    observed_precip = np.random.exponential(0.8, time_length)\n",
    "    \n",
    "    # Add some temporal correlation to make it more realistic\n",
    "    for i in range(1, time_length):\n",
    "        if model_precip[i-1] > 0.1:  # If previous interval was wet\n",
    "            model_precip[i] *= 1.5  # Increase probability of current being wet\n",
    "        if observed_precip[i-1] > 0.1:\n",
    "            observed_precip[i] *= 2.0  # Even stronger persistence in observations\n",
    "    \n",
    "    # Analyze transition probabilities\n",
    "    results = compare_transition_probabilities(model_precip, observed_precip, threshold=0.25)\n",
    "    \n",
    "    # Print summary\n",
    "    print_transition_summary(results)\n",
    "    \n",
    "    # Create plots\n",
    "    fig = plot_transition_comparison(results)\n",
    "    plt.show()"
   ]
  },
