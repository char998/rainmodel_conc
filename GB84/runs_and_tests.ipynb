    "    # Ticks\n",
    "    'xtick.labelsize': 7,\n",
    "    'ytick.labelsize': 7,\n",
    "    'xtick.direction': 'in',\n",
    "    'ytick.direction': 'in',\n",
    "    'xtick.major.size': 5,\n",
    "    'xtick.minor.size': 3,\n",
    "    'ytick.major.size': 5,\n",
    "    'ytick.minor.size': 3,\n",
    "    'xtick.major.width': 1.0,\n",
    "    'xtick.minor.width': 0.7,\n",
    "    'ytick.major.width': 1.0,\n",
    "    'ytick.minor.width': 0.7,\n",
    "    \n",
    "    # Legend\n",
    "    'legend.fontsize': 7,\n",
    "    'legend.framealpha': 1.0,\n",
    "    'legend.edgecolor': 'black',\n",
    "    'legend.fancybox': False,\n",
    "    \n",
    "    # Figure quality\n",
